<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/date_metrou"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/id" />

        <EditText
            android:id="@+id/id_ET"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/ex_1"
            android:inputType="number" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/model_locomotiva" />

        <EditText
            android:id="@+id/model_ET"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/ex_bombardier_movia"
            android:inputType="text" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/numar_vagoane" />

        <EditText
            android:id="@+id/vagoane_ET"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/ex_6"
            android:inputType="number" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/numar_statii" />

        <EditText
            android:id="@+id/statii_ET"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/ex_14"
            android:inputType="number" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/magistrala" />

        <Spinner
            android:id="@+id/magistrala_SP"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:entries="@array/magistrale" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/tip_traseu" />

        <RadioGroup
            android:id="@+id/traseu_RG"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/subteran_RB"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/subteran" />

            <RadioButton
                android:id="@+id/suprateran_RB"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/suprateran" />

            <RadioButton
                android:id="@+id/mixt_RB"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mixt" />
        </RadioGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/grad_uzura" />

        <RatingBar
            android:id="@+id/uzura_RB"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:numStars="5"
            android:stepSize="0.5" />

        <CheckBox
            android:id="@+id/aer_CB"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/aer_conditionat" />

        <Switch
            android:id="@+id/accesibil_SW"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/accesibil_persoanelor_cu_dizabilitati" />

        <Button
            android:id="@+id/salveaza_BTN"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/salveaza" />
    </LinearLayout>
</ScrollView>