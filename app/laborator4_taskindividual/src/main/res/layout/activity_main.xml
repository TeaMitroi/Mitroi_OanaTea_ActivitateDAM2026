<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <Button
        android:id="@+id/adauga_BTN"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/adauga_metrou_design_simplu" />

    <Button
        android:id="@+id/adaugaAi_BTN"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/adauga_metrou_design_ai" />

    <Button
        android:id="@+id/lista_BTN"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/lista_metrouri" />

    <TextView
        android:id="@+id/rezultat_TV"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:textSize="18sp"
        android:text="@string/niciun_metrou_adaugat_inca" />
</LinearLayout>